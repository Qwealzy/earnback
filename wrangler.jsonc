// Cloudflare Workers static-assets deploy of the Earnback app (no server code).
// Build (Workers Builds): cd studio && bun install --frozen-lockfile --ignore-scripts && bunx --bun vite build
// Build variables: VITE_NETWORK=mainnet, BUN_VERSION=1.3.14
{
  "name": "earnback",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./studio/dist",
    // client-side routes such as /proof and /agreement/7 fall back to index.html
    "not_found_handling": "single-page-application"
  }
}
